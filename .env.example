# ==========================================
# TG ALARM CONFIGURATION
# ==========================================

# 1. Main Userbot Monitor (Your primary Telegram account)
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here
TG_PHONE=+380000000000

# Target bot(s) username or user_id to monitor (comma separated if multiple)
# Example: @important_signal_bot or 123456789
TARGET_BOT_USERNAME=@important_signal_bot

# 2. Telegram Admin Bot (Bot API token created via @BotFather)
ADMIN_BOT_TOKEN=1234567890:AAA_your_bot_token_here
ADMIN_CHAT_ID=123456789 # Your Telegram user_id for receiving alerts and controlling the bot

# 3. Caller Account (Second Telegram account for waking calls)
# Needs separate API_ID/HASH or can use the same application credentials with a different phone number
CALLER_API_ID=12345678
CALLER_API_HASH=your_api_hash_here
CALLER_PHONE=+380999999999
CALLER_SESSION_NAME=caller_session

# Optional Twilio Backup
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
